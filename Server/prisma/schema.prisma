generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  firstname String
  lastname  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("admin")
}

model User {
  id           String   @id @default(uuid())
  firstname    String
  lastname     String
  email        String   @unique
  password     String
  profilephoto String?
  isBlocked    Boolean
  isAdmin      Boolean
  createdAt    DateTime

  addresses Address[]
  purchases Purchase[]
  cartItems CartItem[]
  favorites Favorite[]

  @@map("user")
}

model Address {
  id      String @id @default(uuid())
  street  String // Endereço
  number  String // Número
  zipcode String // Código Postal
  parish  String // Freguesia
  county  String // Concelho
  state   String // Estado
  country String // País

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("address")
}

model Book {
  id              String  @id @default(uuid())
  title           String
  bookphoto       String?
  description     String
  author          String
  publicationYear Int
  genre           String
  isbn            String  @unique
  price           Float

  supplierId String?
  userId     String?

  supplier  Supplier?  @relation(fields: [supplierId], references: [id])
  purchase  Purchase[]
  cartItems CartItem[]
  favorites Favorite[]

  @@map("book")
}

model Purchase {
  id       String   @id @default(uuid())
  userId   String
  bookId   String
  quantity Int      @default(1)
  date     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@map("purchase")
}

model Supplier {
  id      String @id @default(uuid())
  name    String
  address String
  phone   String

  books Book[]

  @@map("supplier")
}

model CartItem {
  id       String   @id @default(uuid())
  userId   String
  bookId   String
  quantity Int      @default(1)
  addedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
  @@map("cart_item")
}

model Favorite {
  id      String   @id @default(uuid())
  userId  String
  bookId  String
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
  @@map("favorite")
}
