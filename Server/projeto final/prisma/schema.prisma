// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  firstname    String
  lastname     String
  email        String   @unique
  password     String
  profilephoto String?
  isBlocked    Boolean
  createdAt    DateTime

  adresses Adress[]
  reviews  Review[]

  @@map("user")
}

model Adress {
  id      String @id @default(uuid())
  street  String
  city    String
  state   String
  zipcode String
  userId  String

  user User @relation(fields: [userId], references: [id])

  @@map("adress")
}

model Book {
  id              String @id @default(uuid())
  title           String
  author          String
  publicationYear Int
  genre           String
  isbn            String @unique
  price           Int

  reviews    Review[]
  Supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  @@map("book")
}

model Review {
  id      String @id @default(uuid())
  content String
  rating  Int
  userId  String
  bookId  String

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@unique([bookId, userId])
  @@map("review")
}

model Supplier {
  id      String @id @default(uuid())
  name    String
  address String
  phone   String

  books Book[]

  @@map("supplier")
}
